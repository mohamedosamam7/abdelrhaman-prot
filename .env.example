# Copy to .env.local for local overrides. Never commit real values.

# Public origin used for canonical URLs, hreflang and the sitemap.
# Optional on Vercel: the project's production domain is used automatically.
# Set it when a custom domain is added, e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=

# ── Supabase (content dashboard) ─────────────────────────────────────────
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). SERVER ONLY — used by scripts/cms/create-admin.mjs.
# Never prefix with NEXT_PUBLIC_, never commit, never paste anywhere public.
SUPABASE_SECRET_KEY=
# Postgres connection string (Session pooler) for scripts/cms/migrate.mjs.
SUPABASE_DB_URL=
